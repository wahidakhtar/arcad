ACTIVE_SLOT=blue
INACTIVE_SLOT=green
PUBLIC_HTTP_PORT=80
TEST_HTTP_PORT=8082

API_IMAGE=ghcr.io/your-org/arcad-api
FRONTEND_IMAGE=ghcr.io/your-org/arcad-frontend
IMAGE_TAG=latest

POSTGRES_USER=arcad
POSTGRES_PASSWORD=changeme
POSTGRES_DB=arcad_db
TEST_POSTGRES_DB=arcad_db_test

# Each slot has its own DB URL. On promote, these are swapped automatically.
# Initially: blue=active(production), green=inactive(test)
BLUE_DATABASE_URL=postgresql://arcad:changeme@db:5432/arcad_db
GREEN_DATABASE_URL=postgresql://arcad:changeme@db-test:5432/arcad_db_test

SECRET_KEY=
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost
